# FinanzAdmin Pro — variables del worker de importaciones
# Copiar como secreto en Coolify (no versionar valores reales).
DATABASE_URL=postgres://usuario:contraseña@postgres:5432/finanzadmin
# DATABASE_SSL=true
NVIDIA_API_KEY=clave-de-nvidia-nim
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# IMPORT_MODEL=nvidia/nemotron-3-super-120b-a12b
# PDFTOTEXT_BIN=pdftotext
IMPORT_STORAGE_DIR=/app/server/uploads
IMPORT_POLL_INTERVAL_MS=30000
