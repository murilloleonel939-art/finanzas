# FinanzAdmin Pro — variables del worker de precios
#
# Copiar a /etc/worker-precios.env y rellenar:
#   sudo cp deploy/worker-precios.env.example /etc/worker-precios.env
#   sudo chmod 600 /etc/worker-precios.env
#
# ESTE ARCHIVO NO SE VERSIONA CON SECRETOS. El `.example` va al repo; el real
# vive solo en el servidor.

DATABASE_URL=postgres://usuario:contraseña@postgres:5432/finanzadmin
# DATABASE_SSL=true

# --- Programación (opcional; estos son los valores por defecto) ---

# Hora del barrido completo, en la zona de abajo. 16:00 de Bogotá es después del
# cierre de EE. UU. en verano e invierno, así que el precio guardado es el
# cierre real. Ver D31.
BARRIDO_HORA=16:00

# Zona del barrido. Se resuelve con Intl, no con un desfase fijo: si se cambia a
# una zona con horario de verano, sigue funcionando.
BARRIDO_TZ=America/Bogota

# Cada cuánto se revisa la cola del botón «actualizar ahora» (ms).
POLL_INTERVAL_MS=300000
