# Supabase — obligatorias
# Project Settings → API en el dashboard de Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------
# NOTA IMPORTANTE SOBRE SEGURIDAD
# ---------------------------------------------------------------------
# Estas dos variables se INCRUSTAN en el bundle en tiempo de build (son
# variables de Vite, prefijo VITE_). Quedan visibles en el JavaScript que
# descarga el navegador. Eso es lo normal y esperado en Supabase.
#
# Consecuencia: cualquiera puede leer la anon key y llamar directamente a
# la API REST, saltándose la aplicación. Por eso el aislamiento por empresa
# NO depende del frontend, sino del RLS (migración 0006).
#
# La service_role key NUNCA va aquí. Se salta el RLS por completo y solo
# puede usarse en el servidor (Edge Functions y el worker de IA en EC2).

# Opcional — solo si se activa en la FASE 17/18
# VITE_IA_PROVIDER=anthropic
# VITE_MARKET_API=finnhub
